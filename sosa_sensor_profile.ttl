@prefix ismatemplate:    <https://w3id.org/cnr-ismar/sensor-template/> .
@prefix ismainstance:    <https://w3id.org/cnr-ismar/sensor-instance/> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix prov:            <http://www.w3.org/ns/prov#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:            <http://www.w3.org/ns/adms#> .
@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix sosa:            <http://www.w3.org/ns/sosa/> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix ssn-system:      <http://www.w3.org/ns/ssn/systems/> .
@prefix omtype:          <http://www.opengis.net/def/observationType/OGC-OM/2.0/> .
@prefix unit:            <http://qudt.org/vocab/unit/> .
@prefix p02:             <http://vocab.nerc.ac.uk/collection/P02/current/> .
@prefix ex:              <https://example.org/> .

# This graph describes a reusable instrument-model template and its sensing subsystems.
# The deployment at the end identifies one use of the model, not the model itself.
ismatemplate:CTD-SB37
    # The entity responsable for the creation of this profile
    prov:wasAttributedTo <https://orcid.org/0000-0002-7997-219X> ;
    prov:qualifiedAttribution [
      a prov:Attribution ;
      prov:agent <https://orcid.org/0000-0002-7997-219X> ;
      prov:hadRole <http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/author> ;
    ] ;

    # The date time of creation of this profile
	dcterms:created "2026-10-08T09:46:37Z"^^xsd:dateTime ;

    # Version indicator for this semantic profile
    dcat:version "1.0.0" ;

    # The date time this version of the profile was last modified
	dcterms:modified "2026-10-08T09:46:37Z"^^xsd:dateTime ;

    # sosa:System describes the instrument system; schema:ProductModel identifies its product model.
    a sosa:System, schema:ProductModel ;

	# The example URI identifies the version of the template this profile follows.
	# Replace it with the persistent URI when the template specification is published.
	dcterms:conformsTo <https://example.org/cnr-ismar/sensor-template/v1.0.0> ;

    # Manufacturer is linked to the NERC vocabulary entry; the labels are human-readable names.
    schema:manufacturer <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> ;
	rdfs:label "SeaBird model SBE37" ;

    # Mandatory system-generated alternative identifier intended for systems requiring compact alphanumeric identifiers.
    skos:notation "SB-SB37" ;
    dcterms:identifier "a4a977dd-2b55-4927-bb6c-c8bdda52409d" ;
    dcterms:identifier "urn:uuid:6d7c67f6-9e9f-4c1e-8c44-bce7c2926932" ;
    adms:identifier [
        a adms:Identifier ;
        skos:notation "adriatic_temperature_daily" ;
        dcterms:type ex:String32
    ] ;

    adms:identifier [
        a adms:Identifier ;
        skos:notation "ismar_temp_001" ;
       dcterms:type ex:SimpleString
    ] ;

    dcat:landingPage <https://rdfdata.lteritalia.it/sensors/systemsType/NoX/JB_Hyperspectral_Devices/a4a977dd-2b55-4927-bb6c-c8bdda52409d.xml> ;

    # The product part number identifies the specific SBE37 variant represented in this example.
    schema:mpn "SBE37-SMP-ODO" ;

    # NERC identifies this SeaBird model; GCMD classifies it as a CTD instrument class.
    dcterms:source <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0869/> ;
    schema:category <https://gcmd.earthdata.nasa.gov/kms/concept/01cc0beb-7c9a-40ed-ad86-0661b41aee53> ;

    # General model description, official product page, image, and datasheet.
    schema:description "A series of high accuracy conductivity and temperature recorders with optional pressure sensors and an Optical Dissolved Oxygen (ODO) sensor designed for deployment on moorings. The SM model uses a serial interface (SM) for real-time data transmissions and has internal batteries. It is fitted with an integral pump (P). The sensors may or may not have an integrated pressure sensor."@en ;
    rdfs:comment "A series of high accuracy conductivity and temperature recorders with optional pressure sensors and an Optical Dissolved Oxygen (ODO) sensor designed for deployment on moorings. The SM model uses a serial interface (SM) for real-time data transmissions and has internal batteries. It is fitted with an integral pump (P). The sensors may or may not have an integrated pressure sensor."@en ;

    schema:url <https://www.seabird.com/products/sbe-37-microcat?id=54627886792> ;
    schema:image <https://www.seabird.com/hubfs/Imagery/Product%20Imagery/SBE%2037/Renderings/SBE37_3qtr.png> ;
    schema:subjectOf <https://www.seabird.com/cms-portals/seabird_com/cms/documents/datasheets/37-SMP-ODO.pdf> ;

    # The decoder is software required to turn the instrument's encoded output into observations.
    dcterms:requires ismatemplate:CTD-SB37-DecodeDriver ;

    # The following common-property values are demonstration values taken from the Sentinel YAML.
    # They illustrate the mapping and are not verified specifications of the SeaBird model.
    schema:material "Plastic body with metal-shell connector" ;
    # Dimensions use centimetres (CMT); weight uses kilograms (KGM).
    # Length and diameter are represented as additional properties because Schema.org has no dedicated terms for them.
    schema:width [
        a schema:QuantitativeValue ;
        schema:value 0.0 ;
        schema:unitCode "CMT"
    ] ;
    schema:height [
        a schema:QuantitativeValue ;
        schema:value 0.0 ;
        schema:unitCode "CMT"
    ] ;
    schema:weight [
        a schema:QuantitativeValue ;
        schema:value 4.0 ;
        schema:unitCode "KGM"
    ] ;
    # Zero width and height are copied as supplied in the reference YAML; check whether they mean unknown.
    # Additional common characteristics are expressed as PropertyValue pairs when Schema.org has no specific term.
    schema:additionalProperty [
        a schema:PropertyValue ;
        # Instrument may be physical or virtual.
        schema:name "deviceType" ;
        schema:value "virtual"
    ], [
        a schema:PropertyValue ;
        # Indicates whether the instrument stores measurements internally.
        schema:name "temporaryStorage" ;
        schema:value true
    ], [
        a schema:PropertyValue ;
        # Describes the data as instantaneous, cumulative, or various.
        schema:name "dataType" ;
        schema:value "instantaneous"
    ], [
        a schema:PropertyValue ;
        # Format of the data produced by the instrument.
        schema:name "outputDataFormat" ;
        schema:value "proprietary"
    ], [
        a schema:PropertyValue ;
        # Length and diameter are in centimetres.
        schema:name "length" ;
        schema:value 17.3 ;
        schema:unitCode "CMT"
    ], [
        a schema:PropertyValue ;
        schema:name "diameter" ;
        schema:value 17.8 ;
        schema:unitCode "CMT"
    ], [
        a schema:PropertyValue ;
        # Power supply characteristics are useful for operation and maintenance.
        schema:name "electricalCurrentType" ;
        schema:value "DC"
    ], [
        a schema:PropertyValue ;
        schema:name "inputPowerRange" ;
        schema:value "12-20 VDC"
    ], [
        a schema:PropertyValue ;
        # Operating temperature limits are expressed in degrees Celsius.
        schema:name "operatingTemperature" ;
        schema:minValue -5 ;
        schema:maxValue 45 ;
        schema:unitCode "CEL"
    ] ;

    # Each subsystem represents one sensing component; sosa:observes links it to the measured property.
    sosa:hasSubSystem [
        a sosa:Sensor ;
        dcterms:identifier "T1" ;
		sosa:observes p02:TEMP ;
		schema:unitCode unit:DEG_C ;
        schema:additionalProperty [
            a schema:PropertyValue ;
            schema:name "observationType" ;
            schema:value omtype:OM_Measurement
        ] ;
        # Accuracy, resolution, and range are system capabilities, with their measurement units.
        ssn-system:hasSystemCapability [
            a ssn-system:SystemCapability ;
            ssn-system:hasSystemProperty [
                a sosa:Property, ssn-system:Accuracy, schema:PropertyValue ;
                schema:value 0.01 ;
                schema:unitCode unit:DEG_C
            ], [
                a sosa:Property, ssn-system:Resolution, schema:PropertyValue ;
                schema:value 0.0001 ;
                schema:unitCode unit:DEG_C
            ], [
                a sosa:Property, schema:PropertyValue ;
                schema:name "measurementRange" ;
                schema:minValue 350 ;
                schema:maxValue 1650 ;
                schema:unitCode unit:DEG_C
            ]
        ]
    ] ;
    sosa:hasSubSystem [
        a sosa:Sensor ;
        dcterms:identifier "C1" ;
		sosa:observes p02:CNDC ;
		schema:unitCode unit:S-PER-M ;
        schema:additionalProperty [
            a schema:PropertyValue ;
            schema:name "observationType" ;
            schema:value omtype:OM_Measurement
        ] ;
        ssn-system:hasSystemCapability [
            a ssn-system:SystemCapability ;
            ssn-system:hasSystemProperty [
                a sosa:Property, ssn-system:Accuracy, schema:PropertyValue ;
                schema:value 0.0003 ;
                schema:unitCode unit:S-PER-M
            ], [
                a sosa:Property, ssn-system:Resolution, schema:PropertyValue ;
                schema:value 0.00001 ;
                schema:unitCode unit:S-PER-M
            ], [
                a sosa:Property, schema:PropertyValue ;
                schema:name "measurementRange" ;
                schema:minValue 350 ;
                schema:maxValue 1650 ;
                schema:unitCode unit:S-PER-M
            ]
        ]
    ] .

# Software decoder associated with this instrument-model profile.
ismatemplate:CTD-SB37-DecodeDriver
    a schema:SoftwareSourceCode ;
    schema:name "SBE37 data decoder" ;
    schema:description "Software required to decode data streams produced by the CTD-SB37 model, including ASCII, XML, or JSON formats, and extract its observations as structured data."@en ;
    schema:programmingLanguage "Python" ;
    schema:encodingFormat "text/x-python" ;
    schema:url <https://example.org/drivers/ctd-sb37-decode-driver.py> .

